# ==========================================
# EventForge Production .gitignore
# ==========================================

# 1. Sensitive Environment & Credentials (NEVER COMMIT)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
*.pem
*.key

# 2. Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# 3. Build & Distribution Outputs
dist/
build/
*/dist/
out/
.next/

# 4. Logs & Debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. OS & IDE Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Database & Persistent Data Volumes
pgdata/
redisdata/
*.sqlite
*.sqlite3

# 7. Antigravity Brain Artifacts
.gemini/
.agents/
