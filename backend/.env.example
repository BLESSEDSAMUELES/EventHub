# ==============================================================================
# EventForge / EventHub Production Environment Configuration
# ==============================================================================

# Server Port
PORT=4000

# ------------------------------------------------------------------------------
# PostgreSQL / Supabase Connection
# ------------------------------------------------------------------------------
# Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Supabase Transaction Pooler (Port 6543 - Recommended for Serverless/Node):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Leave empty to run with local in-memory ACID transactional engine:
DATABASE_URL=

# Set to true when connecting to hosted PostgreSQL / Supabase with SSL:
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# Redis & BullMQ Expiry Queue (Optional)
# ------------------------------------------------------------------------------
# Set when using Redis for distributed background jobs. Leave empty to use
# the robust internal recurring sweep worker (10-second sweep loop).
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Security & Auth Tokens
# ------------------------------------------------------------------------------
# HS256 secret key for signing attendee, organizer, and admin JWT tokens
JWT_SECRET=super-secret-jwt-key-eventforge-2026-production-ready

# Shared secret key expected in the 'x-mock-webhook-secret' header for payment webhooks
MOCK_PAYMENT_WEBHOOK_SECRET=eventforge-mock-webhook-secret-xyz

# Allowed Frontend Origin for CORS headers
FRONTEND_ORIGIN=http://localhost:5173

# Temporary reservation hold duration in minutes (Default: 10 minutes)
HOLD_MINUTES=10
