# Production Backend Environment Variables
PORT=4000
NODE_ENV=production

# Database Connection (e.g., Supabase, Neon, AWS RDS, or Render PostgreSQL)
# Tip: URL-encode any special characters in the password (e.g. '@' -> '%40')
DATABASE_URL=postgresql://postgres.your-project-ref:your-strong-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Security Secrets (Generate secure random 64-char strings)
JWT_SECRET=super-secret-jwt-key-change-this-in-production-2026-min32chars
MOCK_PAYMENT_WEBHOOK_SECRET=super-secret-webhook-signing-key-production

# CORS allowed frontend origin
FRONTEND_ORIGIN=https://your-frontend-app.vercel.app

# Ticket Hold Timeout (Minutes)
HOLD_MINUTES=10

# Database auto-seed safety flag (set to 'true' only once on initial setup if needed; defaults to false if tenants exist)
AUTO_SEED=false
