                  "    pm.expect(json).to.have.property('totalRevenue');",
                  "    pm.expect(json).to.have.property('conversionRate');",
                  "    pm.expect(json).to.have.property('revenueTrend');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/organizer/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "organizer", "analytics"]
            }
          }
        },
